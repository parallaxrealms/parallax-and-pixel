# Supabase
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
PRIVATE_SUPABASE_KEY=""
JWT_SECRET=""

# Site Configuration
PUBLIC_SITE_ID=""
PUBLIC_PRINT_QUEUE=""
# Absolute base URL the headless browser navigates to when rendering audit PDFs.
# Dev default is http://127.0.0.1:3000; set to the public origin in prod.
PUBLIC_SITE_URL=""

# --- Website Audit tool (admin) ---------------------------------------------
# Google PageSpeed Insights — optional, but bumps Lighthouse quota to 25k/day.
PAGESPEED_API_KEY=""
# Firecrawl (headless scrape). If unset the engine falls back to fetch+cheerio
# (thinner stack / AI-readiness signals, no JS render).
FIRECRAWL_API_KEY=""
# Deploy only (Coolify/Nixpacks): absolute path to the Chromium binary Playwright
# should launch for PDF render. Leave blank locally after `npx playwright install`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# Payment Processor — Stripe only (Square not used)
PAYMENT_PROCESSOR="stripe"

# Stripe
PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# EasyPost Shipping
EASYPOST_API_KEY=""
USE_EASYPOST_IN_DEV=""

# Resend Email
RESEND_API_KEY=""
# Resend webhook signing secret (whsec_...). Verifies POSTs to
# /api/webhooks/resend, which log email activity to the admin Email tab.
RESEND_WEBHOOK_SECRET=""

# Email Configuration
ADMIN_EMAIL=""
FROM_EMAIL=""
CONTACT_EMAIL=""

# --- Bifrost daemon (admin Bifrost chat tab) -------------------------------
# wss/https base of your Bifrost daemon (e.g. https://bifrost.example.com).
# The chat connects directly to it: WebSocket /ws for streaming + REST /api/*,
# authed with the user's Supabase JWT. Blank (or "mock") = tab shows a graceful
# "Bifrost daemon is not configured" banner instead of attempting a connection.
PUBLIC_BIFROST_DAEMON_URL=""
# Shared secret — only needed if you later add daemon→app reporting routes.
# The chat client itself authenticates with the Supabase JWT, not this key.
BIFROST_API_KEY=""

# Node Environment
NODE_ENV="development"

# Deployment Variables
# NIXPACKS_NODE_VERSION=22
# NODE_AUTH_TOKEN=ghp_your_github_personal_access_token

# --- OpenTelemetry (pxp-otel-stack collector) -------------------------------
# All optional; unset OTEL_EXPORTER_OTLP_ENDPOINT = telemetry fully disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=parallax-and-pixel
OTEL_AUTH_TOKEN=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Telemetry dashboard (admin Telemetry tab reads these) ------------------
# Prometheus from pxp-otel-stack (e.g. https://pxp-prom.yggdrasil.quest).
# Set manually in Coolify's env (runtime vars) — nothing generates them.
PROMETHEUS_URL=
# Auth for the Prometheus endpoint — pick ONE (same convention as 9realms):
# Bearer token (if Prometheus is fronted by something that validates a bearer):
PROMETHEUS_BEARER=
# Basic auth (our pxp-otel-stack: Traefik basicauth, format pxp:<password>):
PROMETHEUS_BASIC_AUTH=
# Glances per-server stats (same creds/URLs as 9realms uses)
GLANCES_USERNAME=
GLANCES_PASSWORD=
GLANCES_YGG_URL=
GLANCES_MIDGARD_URL=
GLANCES_HEL1_URL=
