# Supabase
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
PRIVATE_SUPABASE_SATORI_KEY=""
JWT_SECRET=""

# Site Configuration
PUBLIC_SITE_ID=""
PUBLIC_PRINT_QUEUE=""

# Default Payment Processor (stripe | square)
PAYMENT_PROCESSOR="stripe"

# Stripe
PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Square
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_SANDBOX_APPLICATION_ID=""
SQUARE_SANDBOX_ACCESS_TOKEN=""
SQUARE_SANDBOX_LOCATION_ID=""
SQUARE_PRODUCTION_APPLICATION_ID=""
SQUARE_PRODUCTION_ACCESS_TOKEN=""
SQUARE_PRODUCTION_LOCATION_ID=""

# EasyPost Shipping
EASYPOST_API_KEY=""
USE_EASYPOST_IN_DEV=""

# Resend Email
RESEND_API_KEY=""

# Email Configuration
ADMIN_EMAIL=""
FROM_EMAIL=""
CONTACT_EMAIL=""

# Node Environment
NODE_ENV="development"

# Deployment Variables
# NIXPACKS_NODE_VERSION=22
# NODE_AUTH_TOKEN=ghp_your_github_personal_access_token

# --- OpenTelemetry (pxp-otel-stack collector) -------------------------------
# All optional; unset OTEL_EXPORTER_OTLP_ENDPOINT = telemetry fully disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=parallax-and-pixel
OTEL_AUTH_TOKEN=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Telemetry dashboard (admin Telemetry tab reads these) ------------------
# Prometheus from pxp-otel-stack (basic auth user pxp, see that repo's README)
PROMETHEUS_URL=
PROMETHEUS_BASIC_AUTH=
# Glances per-server stats (same creds/URLs as 9realms uses)
GLANCES_USERNAME=
GLANCES_PASSWORD=
GLANCES_YGG_URL=
GLANCES_MIDGARD_URL=
GLANCES_HEL1_URL=
